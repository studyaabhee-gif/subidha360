# The server reads real environment variables; it does not load this file.
# Only "development" is accepted until real SMS and payment integrations exist.
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters

HTTP_ADDR=:8080
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=subidha360
REDIS_ADDR=localhost:6379
# Hosted Redis with a password and TLS (rediss://...). Overrides REDIS_ADDR.
REDIS_URL=

# How long a job waits for bids before escalating.
BID_WINDOW=5m
# How long after the first bid a seeker has to pick one.
SELECTION_WINDOW=24h
# How long after the first completion confirmation escrow auto-releases.
AUTO_RELEASE_AFTER=72h
# How long admins have to decide a seeker's mid-work cancellation.
ESCROW_REVIEW_WINDOW=72h
# How far past a provider's service area an escalated broadcast reaches.
ESCALATION_METERS=5000
# Platform commission in basis points (1000 = 10%).
COMMISSION_BPS=1000

# Firebase project and service account key file, for real push notifications.
# Set both or neither. Without them, pushes are only logged.
# Never commit the key file.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=

# Sparrow SMS API token and approved sender identity, for real SMS.
# Set both or neither. Without them, messages and login codes are only logged.
SPARROW_TOKEN=
SPARROW_FROM=
