# Copy to .env on the server and fill in. Never commit .env.
SITE_DOMAIN=subidha360.com

# Until real payments are connected the server only runs in development mode.
# Caddy blocks the development top-up from the internet regardless.
APP_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=subidha360
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# At least 32 random characters. Changing it logs everyone out.
JWT_SECRET=

# Optional until each service is ready.
SPARROW_TOKEN=
SPARROW_FROM=
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
